<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <joint name="face_joint" type="fixed">
        <parent link="chassis"/>
        <child link="face_link"/>
        <origin xyz="${chassis_length} 0 ${chassis_height/2}" rpy="0 0 0"/>
    </joint>

    <link name="face_link">
        <visual>
            <origin xyz="0 0.045 0.02" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="0.015" length="0.004"/>
            </geometry>
            <material name="black"/>
        </visual>

        <visual>
            <origin xyz="0 -0.045 0.02" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="0.015" length="0.004"/>
            </geometry>
            <material name="black"/>
        </visual>


        <visual>
            <origin xyz="-0.011 0 -0.025" rpy="0 ${pi/2} 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.008"/>
            </geometry>
            <material name="red"/>
        </visual>

        <!-- Creepy wide grin -->
        <visual>
            <origin xyz="0 0 -0.045" rpy="0 0 0"/>
            <geometry>
                <box size="0.004 0.09 0.012"/>
            </geometry>
            <material name="black"/>
        </visual>

        <!-- Curl the grin corners upward -->
        <visual>
            <origin xyz="0.003 0.043 -0.038" rpy="0 0 0.6"/>
            <geometry>
                <box size="0.004 0.02 0.012"/>
            </geometry>
            <material name="black"/>
        </visual>

        <visual>
            <origin xyz="0.003 -0.043 -0.038" rpy="0 0 -0.6"/>
            <geometry>
                <box size="0.004 0.02 0.012"/>
            </geometry>
            <material name="black"/>
        </visual>

        <!-- Jagged teeth -->
        <visual>
            <origin xyz="0.001 0.033 -0.045" rpy="0 0 0"/>
            <geometry>
                <box size="0.002 0.008 0.008"/>
            </geometry>
            <material name="white"/>
        </visual>

        <visual>
            <origin xyz="0.001 0.017 -0.045" rpy="0 0 0"/>
            <geometry>
                <box size="0.002 0.008 0.008"/>
            </geometry>
            <material name="white"/>
        </visual>

        <visual>
            <origin xyz="0.001 0.0 -0.045" rpy="0 0 0"/>
            <geometry>
                <box size="0.002 0.008 0.008"/>
            </geometry>
            <material name="white"/>
        </visual>

        <visual>
            <origin xyz="0.001 -0.017 -0.045" rpy="0 0 0"/>
            <geometry>
                <box size="0.002 0.008 0.008"/>
            </geometry>
            <material name="white"/>
        </visual>

        <visual>
            <origin xyz="0.001 -0.033 -0.045" rpy="0 0 0"/>
            <geometry>
                <box size="0.002 0.008 0.008"/>
            </geometry>
            <material name="white"/>
        </visual>

    </link>

    <gazebo reference="face_link">
        <material>Gazebo/Black</material>
    </gazebo>


</robot>